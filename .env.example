# ========================================================
# CRM CAPTAIN KONVEKSI V1.0 - ENVIRONMENT CONFIGURATION TEMPLATE
# Salin file ini menjadi .env di server lokal / Niagahoster:
# cp .env.example .env
# ========================================================

# Application Server
PORT=3000
NODE_ENV=production
APP_URL="http://localhost:3000"

# JWT Secret for Session & Authentication
# WAJIB diganti dengan acak panjang minimal 32 karakter untuk produksi!
# Contoh generate di bash/terminal: openssl rand -base64 32
JWT_SECRET="ganti_dengan_random_secret_panjang_minimal_32_karakter"
JWT_EXPIRES_IN="24h"

# MySQL Database Configuration (Niagahoster / Production / cPanel)
# Di Niagahoster cPanel, buat Database MySQL & User di menu "MySQL Databases"
DB_HOST="localhost"
DB_PORT=3306
DB_USER="uXXXXXXX_crmcaptain"
DB_PASSWORD="GANTI_DENGAN_PASSWORD_DATABASE_ANDA"
DB_NAME="uXXXXXXX_crm_captain_konveksi"
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT=10000

# Optional Testing Database (Untuk menjalankan test suite terisolasi)
# TEST_DB_HOST="localhost"
# TEST_DB_USER="test_user"
# TEST_DB_PASSWORD="test_password"
# TEST_DB_NAME="test_crm_captain"
